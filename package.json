{
  "name": "n8n-nodes-ibm-quantum",
  "version": "0.6.0",
  "description": "Verified n8n community node for IBM Quantum. Build OpenQASM 3 circuits, submit to Qiskit Runtime, and trigger on job completion or failure. Usable as an AI Agent tool.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ibm-quantum",
    "qiskit",
    "qiskit-runtime",
    "openqasm",
    "quantum-computing",
    "quantum",
    "qpu",
    "ibm-cloud",
    "ai-agent",
    "automation",
    "trigger"
  ],
  "license": "MIT",
  "homepage": "https://tuguidragos.com",
  "author": {
    "name": "Țugui Dragoș-Constantin",
    "email": "contact@tuguidragos.com",
    "url": "https://tuguidragos.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuguiDragos/n8n-nodes-ibm-quantum.git"
  },
  "bugs": {
    "url": "https://github.com/TuguiDragos/n8n-nodes-ibm-quantum/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials tests scripts --write",
    "format:check": "prettier nodes credentials tests scripts --check",
    "lint": "eslint package.json index.js nodes credentials tests scripts --max-warnings 0",
    "lintfix": "eslint package.json index.js nodes credentials tests scripts --fix",
    "scan": "npx --yes @n8n/scan-community-package@latest n8n-nodes-ibm-quantum | node scripts/scan-verdict.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "node scripts/release-guard.mjs && npm run build && npm run lint && npx --no -- n8n-node lint && npm run format:check && npm run test:coverage"
  },
  "files": [
    "dist",
    "index.js",
    "llms.txt",
    "llms-full.txt"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/IbmQuantumApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/IbmQuantum/IbmQuantum.node.js",
      "dist/nodes/IbmQuantum/IbmQuantumTrigger.node.js",
      "dist/nodes/IbmQuantum/IbmQuantumErrorTrigger.node.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@n8n/eslint-plugin-community-nodes": "^0.32.0",
    "@n8n/node-cli": "^0.47.2",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "9.29.0",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "globals": "^17.12.0",
    "n8n-workflow": "2.38.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
