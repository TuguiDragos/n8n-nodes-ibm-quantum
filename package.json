{
  "name": "n8n-nodes-ibm-quantum",
  "version": "0.3.3",
  "description": "Verified n8n community node for IBM Quantum. Build OpenQASM 3 circuits, submit to Qiskit Runtime, and trigger on job completion or failure. Usable as an AI Agent tool.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ibm-quantum",
    "qiskit",
    "qiskit-runtime",
    "openqasm",
    "quantum-computing",
    "quantum",
    "ai-agent",
    "automation",
    "trigger"
  ],
  "license": "MIT",
  "homepage": "https://tuguidragos.com",
  "author": {
    "name": "\u021augui Drago\u0219-Constantin",
    "email": "contact@tuguidragos.com",
    "url": "https://tuguidragos.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuguiDragos/n8n-nodes-ibm-quantum.git"
  },
  "bugs": {
    "url": "https://github.com/TuguiDragos/n8n-nodes-ibm-quantum/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.mjs",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "format:check": "prettier nodes credentials --check",
    "lint": "eslint package.json nodes credentials",
    "lintfix": "eslint package.json nodes credentials --fix",
    "scan": "npx --yes @n8n/scan-community-package@latest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run lint && npm run test"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/IbmQuantumApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/IbmQuantum/IbmQuantum.node.js",
      "dist/nodes/IbmQuantum/IbmQuantumTrigger.node.js",
      "dist/nodes/IbmQuantum/IbmQuantumErrorTrigger.node.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "^0.28.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "9.29.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.7",
    "n8n-workflow": "2.34.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
